+</div>
+<div id="lstnumberx739" class="ltx_listingline"><span id="lstnumberx739.1" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;">    </span><span id="lstnumberx739.2" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;">s</span><span id="lstnumberx739.3" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;"> </span><span id="lstnumberx739.4" class="ltx_text ltx_font_typewriter" style="font-size:70%;">=</span><span id="lstnumberx739.5" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;"> </span><span id="lstnumberx739.6" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;">s</span><span id="lstnumberx739.7" class="ltx_text ltx_font_typewriter" style="font-size:70%;">.</span><span id="lstnumberx739.8" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;">replace</span><span id="lstnumberx739.9" class="ltx_text ltx_font_typewriter" style="font-size:70%;">(</span><span id="lstnumberx739.10" class="ltx_text ltx_lst_string ltx_font_typewriter" style="font-size:70%;">"<span id="lstnumberx739.10.1" class="ltx_text ltx_lst_space">␣</span>"</span><span id="lstnumberx739.11" class="ltx_text ltx_font_typewriter" style="font-size:70%;">,</span><span id="lstnumberx739.12" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;"> </span><span id="lstnumberx739.13" class="ltx_text ltx_lst_string ltx_font_typewriter" style="font-size:70%;">"<span id="lstnumberx739.13.1" class="ltx_text ltx_lst_space">␣␣␣</span>"</span><span id="lstnumberx739.14" class="ltx_text ltx_font_typewriter" style="font-size:70%;">)</span>
+</div>
+<div id="lstnumberx740" class="ltx_listingline"><span id="lstnumberx740.1" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;">    </span><span id="lstnumberx740.2" class="ltx_text ltx_lst_keyword ltx_font_typewriter ltx_font_bold" style="font-size:70%;">return</span><span id="lstnumberx740.3" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;"> </span><span id="lstnumberx740.4" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;">s</span>
+</div>
