+<div id="lstnumberx738" class="ltx_listingline"><span id="lstnumberx738.1" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;">    </span><span id="lstnumberx738.2" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;">s</span><span id="lstnumberx738.3" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;"> </span><span id="lstnumberx738.4" class="ltx_text ltx_font_typewriter" style="font-size:70%;">=</span><span id="lstnumberx738.5" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;"> </span><span id="lstnumberx738.6" class="ltx_text ltx_lst_string ltx_font_typewriter" style="font-size:70%;">""</span><span id="lstnumberx738.7" class="ltx_text ltx_font_typewriter" style="font-size:70%;">.</span><span id="lstnumberx738.8" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;">join</span><span id="lstnumberx738.9" class="ltx_text ltx_font_typewriter" style="font-size:70%;">(</span><span id="lstnumberx738.10" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;">char</span><span id="lstnumberx738.11" class="ltx_text ltx_font_typewriter" style="font-size:70%;">.</span><span id="lstnumberx738.12" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;">upper</span><span id="lstnumberx738.13" class="ltx_text ltx_font_typewriter" style="font-size:70%;">()</span><span id="lstnumberx738.14" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;"> </span><span id="lstnumberx738.15" class="ltx_text ltx_lst_keyword ltx_font_typewriter ltx_font_bold" style="font-size:70%;">if</span><span id="lstnumberx738.16" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;"> </span><span id="lstnumberx738.17" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;">i</span><span id="lstnumberx738.18" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;"> </span><span id="lstnumberx738.19" class="ltx_text ltx_font_typewriter" style="font-size:70%;">%</span><span id="lstnumberx738.20" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;"> </span><span id="lstnumberx738.21" class="ltx_text ltx_font_typewriter" style="font-size:70%;">2</span><span id="lstnumberx738.22" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;"> </span><span id="lstnumberx738.23" class="ltx_text ltx_font_typewriter" style="font-size:70%;">==</span><span id="lstnumberx738.24" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;"> </span><span id="lstnumberx738.25" class="ltx_text ltx_font_typewriter" style="font-size:70%;">0</span><span id="lstnumberx738.26" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;"> </span><span id="lstnumberx738.27" class="ltx_text ltx_lst_keyword ltx_font_typewriter ltx_font_bold" style="font-size:70%;">else</span><span id="lstnumberx738.28" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;"> </span><span id="lstnumberx738.29" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;">char</span><span id="lstnumberx738.30" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;"> </span><span id="lstnumberx738.31" class="ltx_text ltx_lst_keyword ltx_font_typewriter ltx_font_bold" style="font-size:70%;">for</span><span id="lstnumberx738.32" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;"> </span><span id="lstnumberx738.33" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;">i</span><span id="lstnumberx738.34" class="ltx_text ltx_font_typewriter" style="font-size:70%;">,</span><span id="lstnumberx738.35" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;"> </span><span id="lstnumberx738.36" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;">char</span><span id="lstnumberx738