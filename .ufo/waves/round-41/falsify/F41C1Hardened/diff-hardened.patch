+def file_sha256(p):
+    """Content digest of one file, streamed: no read of the whole file into memory."""
+    h = hashlib.sha256()
+    with open(p, "rb") as fh:
+        while chunk := fh.read(1 << 20):
+            h.update(chunk)
+    return h.hexdigest()
