+def _fields(line, skip):
+    """The `key=value` tokens of a receipt line, from token index `skip`."""
+    out = {}
+    for token in line.split()[skip:]:
+        if "=" in token:
+            key, value = token.split("=", 1)
+            out[key] = value
+    return out
