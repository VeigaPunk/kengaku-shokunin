+def lane_root():
+    """Lane root holding the committed probe and the committed grader bytes.
+
+    Strict mode must compare a receipt against committed bytes, so it must not trust
+    the running file's own directory: the probe also runs from a proposed copy under
+    .ufo/waves/ and from scratch copies.  Walk up from this file for the committed
+    markers, then fall back to the path the frozen strict requirement names.
+    """
+    here = pathlib.Path(__file__).resolve()
+    for parent in here.parents:
+        if all((parent / marker).is_file() for marker in STRICT_LANE_MARKERS):
+            return parent
+    return pathlib.Path(LANE_ROOT_FALLBACK)
+
