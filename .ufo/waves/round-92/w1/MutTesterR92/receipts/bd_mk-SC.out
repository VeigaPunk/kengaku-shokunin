CHECK R42-R2 base-rc=1 base='cd "$LANE" && python3 plans/routed_open.py --lane . --list | grep -qE \'^ROW R42-R2\\.[12] status=closed\' && test -f plans/scratch_guard.py' override-rc=0 override="test -f plans/scratch_guard.py && python3 plans/scratch_guard.py --selftest >/dev/null 2>&1 && grep -qs 'scratch-root-guard' SKILL.md" reason='Base check exits 1 at the tip because routed_open.py --list prints no ROW R42-R2.x lines (DEFECT line=125 in its output); the R90 check pins the landed scratch_guard.py selftest and the SKILL.md scratch-root-guard row instead, and exits 0 at the tip.' base_out=''
CHECK R42-R3-33 base-rc=0 base='grep -qF \'9 witnessed of 20\' "$LANE/plans/round-43-claims.md"' override-rc=0 override="grep -qF '9 witnessed of 20' plans/round-43-claims.md" reason='Base check and R90 check both exit 0 at the tip with LANE set to the lane root; the R90 check writes the same grep with a lane-relative path, so the override changes spelling, not predicate.' base_out=''
CHECK R42-R3-37 base-rc=0 base='cd "${LANE:?}" && grep -q \'host="libc-rand"\' plans/feal_probe.py && grep -q "libc.srand" plans/feal_probe.py && grep -q "host=libc-rand" corpus/knowledge/tb2-feal-differential-cryptanalysis-grader.md' override-rc=0 override='grep -q \'host="libc-rand"\' plans/feal_probe.py && grep -q \'libc.srand\' plans/feal_probe.py && grep -q \'host=libc-rand\' corpus/knowledge/tb2-feal-differential-cryptanalysis-grader.md' reason='Base check and R90 check both exit 0 at the tip with LANE set to the lane root; ${LANE:?} and $LANE expand to the same root, and the R91 check uses lane-relative paths, so the override changes spelling, not predicate.' base_out=''
rc=1
