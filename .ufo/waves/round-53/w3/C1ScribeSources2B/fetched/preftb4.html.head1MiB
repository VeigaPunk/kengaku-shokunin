en\":[[\"$\",\"$L6\",null,{\"href\":\"/blog\",\"className\":\"section-title block hover:text-green\",\"children\":\"Blog\"}],[\"$\",\"span\",null,{\"className\":\"section-count bg-pink\"}]]}],[\"$\",\"div\",null,{\"className\":\"col-span-full lg:col-start-4 lg:col-span-9\",\"children\":[[\"$\",\"header\",null,{\"className\":\"blog-header\",\"children\":[[\"$\",\"h1\",null,{\"className\":\"blog-title\",\"children\":\"Terminal Bench 4: Every Issue We Found\"}],[\"$\",\"p\",null,{\"className\":\"blog-meta\",\"children\":[[\"$\",\"span\",null,{\"children\":\"Companion to\"}],[\"$\",\"$L6\",null,{\"href\":\"/blog/terminal-bench-4-is-saturated/\",\"className\":\"underline underline-offset-4 hover:text-green\",\"children\":\"Terminal Bench 4 Is Saturated\"}],[\"$\",\"span\",null,{\"children\":[\"Checked \",[\"$\",\"time\",null,{\"dateTime\":\"2026-10-20\",\"children\":\"10.20.26\"}]]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"blog-body-html\",\"children\":[[\"$\",\"p\",null,{\"children\":[\"This is every finding from our review of the \",65,\" \",\"Terminal Bench 4 tasks we ported to\",\" \",[\"$\",\"$L6\",null,{\"href\":\"/blog/introducing-karotte/\",\"children\":\"Karotte\"}],\":\",\" \",242,\" in all, grouped by task. For each one we say what goes wrong on Harbor and what our port does about it. The line under each task name shows how many of five runs each model passed on the Terminal Bench 4 leaderboard, at max reasoning effort; a run that crashed counts as a fail.\"]}],[\"$\",\"p\",null,{\"children\":[\"Findings come from our own review of the tasks and of the transcripts Harbor published (helped by Kilo, our automated review system), from issues filed on\",\" \",[\"$\",\"a\",null,{\"href\":\"https://github.com/harbor-framework/terminal-bench/issues\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":\"Harbor's GitHub\"}],\", from\",\" \",[\"$\",\"a\",null,{\"href\":\"https://epoch.ai/benchmarks/terminal-bench-4/review\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":\"Epoch's review\"}],\" \",\"and from\",\" \",[\"$\",\"a\",null,{\"href\":\"https://usetokenless.com/blog/envcheck/\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":\"Tokenless's audit\"}],\".\"]}]]}],[\"$\",\"dl\",null,{\"className\":\"tb-legend\",\"children\":[[\"$\",\"dt\",null,{\"children\":\"Reward hack\"}],[\"$\",\"dd\",null,{\"children\":\"A way to pass the task without actually solving it. We tried it on Harbor's own grader and it passed, unless it is marked untested.\"}],[\"$\",\"dt\",null,{\"children\":\"Ambiguity\"}],[\"$\",\"dd\",null,{\"children\":\"The grader checks for something the instructions don't mention, only hint at, or say the opposite of.\"}],[\"$\",\"dt\",null,{\"children\":\"Grading or isolation\"}],[\"$\",\"dd\",null,{\"children\":\"Any other problem with how the task is scored or set up, like a correct answer that gets 0, or a way for the agent to change its own score.\"}],[\"$\",\"dt\",null,{\"children\":\"Status\"}],[\"$\",\"dd\",null,{\"children\":\"Fixed: gone in our port. Partial: narrowed but still possible. Open: our port still has it. Won't fix: kept on purpose.\"}]]}],[\"$\",\"$L39\",null,{\"filters\":[{\"key\":\"all\",\"label\":\"All\",\"count\":242},{\"key\":\"hack\",\"label\":\"Reward hacks\",\"count\":141},{\"key\":\"ambiguity\",\"label\":\"Ambiguities\",\"count\":74},{\"key\":\"grading\",\"label\":\"Grading and isolation\",\"count\":28}],\"target\":\"tb-issues\"}],[\"$\",\"div\",null,{\"id\":\"tb-issues\",\"className\":\"tb-issues\",\"children\":[[\"$\",\"nav\",null,{\"className\":\"tb-index\",\"aria-label\":\"Tasks\",\"children\":[[\"$\",\"a\",\"benchmark-wide\",{\"href\":\"#benchmark-wide\",\"data-cats\":\"grading\",\"children\":[\"whole benchmark\",[\"$\",\"span\",null,{\"children\":3}]]}],[\"$\",\"a\",\"atrx-vep-crispr\",{\"href\":\"#atrx-vep-crispr\",\"data-cats\":\"hack ambiguity\",\"children\":[\"atrx-vep-crispr\",[\"$\",\"span\",null,{\"children\":2}]]}],[\"