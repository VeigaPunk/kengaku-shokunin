+            continue
+        delta = strict_tokens(line).get("delta")
+        if delta is None:
+            defects.append("s5 nobind-line-without-delta %r" % line)
+        elif delta != "0":
+            defects.append("s5 nobind delta=%s != 0" % delta)
+    for name in FROZEN_VECTORS:
