+# --- strict gate (R67-C2: clauses s1-s6) -------------------------------------
+
+STRICT_PROBE_REL = "plans/round65_c1_sqlite_probe.py"
+STRICT_DRIVER = "/usr/bin/python3 /ctl/driver.py"
+STRICT_SESSION_NOBIND = ("NOBIND before-battery ", "NOBIND after-battery ")
