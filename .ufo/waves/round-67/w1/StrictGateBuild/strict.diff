+            elif rc.group(1) != "0":
+                defects.append("s5 run-line rc=%s != 0" % rc.group(1))
+            if driver is None:
+                defects.append("s5 run-line-without-driver %r" % line)
+            elif driver.group(1) != STRICT_DRIVER:
+                defects.append("s5 run-driver %r != %r"
