+            defects.append("s5 %s nobind-line-missing" % name)
+        for kind in ("BUILD", "FILES", "ENV"):
+            if not any(line.startswith("%s %s " % (kind, name)) for line in lines):
+                defects.append("s5 %s %s-line-missing" % (name, kind.lower()))
